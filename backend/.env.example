# ResearchMind Configuration

# App Configuration
APP_NAME=ResearchMind

# LLM Provider Configuration
# Options: openai, anthropic, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4-turbo

# OpenAI (if using OpenAI models)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Anthropic (if using Claude models)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Search Provider Configuration
# Options: tavily, mock
SEARCH_PROVIDER=mock

# Tavily API (AI-native search for research)
# Get key from: https://tavily.com/
TAVILY_API_KEY=tvly_your-key-here

# API Configuration
HOST=127.0.0.1
PORT=8000
